# API Configuration
VITE_API_URL=http://localhost:8000
VITE_API_TIMEOUT=30000

# WebSocket Configuration
VITE_WS_URL=ws://localhost:8000/ws
VITE_WS_RECONNECT_INTERVAL=5000
VITE_WS_MAX_RECONNECT_ATTEMPTS=10

# Authentication
VITE_AUTH_TOKEN_KEY=auth_token
VITE_AUTH_REFRESH_TOKEN_KEY=refresh_token
VITE_AUTH_TOKEN_EXPIRY_BUFFER=300000

# Feature Flags
VITE_ENABLE_OFFLINE_MODE=true
VITE_ENABLE_PERFORMANCE_MONITORING=true
VITE_ENABLE_ERROR_REPORTING=true
VITE_ENABLE_ANALYTICS=false

# Logging Configuration
VITE_LOG_LEVEL=info
VITE_ENABLE_REMOTE_LOGGING=false
VITE_LOG_ENDPOINT=

# Performance Configuration
VITE_MEMORY_TRACKING_INTERVAL=30000
VITE_ENABLE_PERFORMANCE_WARNINGS=true

# PWA Configuration
VITE_PWA_ENABLED=true
VITE_PWA_CACHE_NAME=rag-platform-cache

# Development Configuration
VITE_ENABLE_MOCK_API=false
VITE_ENABLE_DEBUG_MODE=false
VITE_SHOW_PERFORMANCE_METRICS=false

# Build Configuration
VITE_BUILD_ANALYZE=false
VITE_BUILD_SOURCEMAP=hidden

# External Services
VITE_SENTRY_DSN=
VITE_GOOGLE_ANALYTICS_ID=
VITE_HOTJAR_ID=

# Security
VITE_CSP_NONCE=
VITE_ENABLE_HTTPS=false